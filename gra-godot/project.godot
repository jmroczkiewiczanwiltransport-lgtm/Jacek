; Engine configuration file.
config_version=5

[application]

config/name="Kurs na czas 3D"
config/description="Symulator jazdy zestawem z naczepą: droga ekspresowa, rondo, plac i cofanie pod rampę."
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/icon="res://icon.svg"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
